        <filename>$data/objects/multiPurchaseItem/multiPurchaseItem.i3d</filename>
        <size width="1.7" length="1.4" height="0.55"/>
        <input allowed="false"/>
        <canBeReset>false</canBeReset>
        <components>
            <component centerOfMass="0 0.1 0" solverIterationCount="10" mass="25" />
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false" />
    </base>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="INSECTICIDE" capacity="29000"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <multipleItemPurchase filename="pallets/canisters/insecticideCanister20.xml" isVehicle="true">
        <itemPositions>
            <itemPosition position="0.000 0 0.000" rotation="0 0 0"/>
            <itemPosition position="-0.420 0 0.000" rotation="0 0 0"/>
            <itemPosition position="-0.840 0 0.000" rotation="0 0 0"/>
            <itemPosition position="-1.260 0 0.000" rotation="0 0 0"/>
            <itemPosition position="0.000 0 -0.470" rotation="0 0 0"/>
            <itemPosition position="-0.420 0 -0.470" rotation="0 0 0"/>
            <itemPosition position="-0.840 0 -0.470" rotation="0 0 0"/>
            <itemPosition position="-1.260 0 -0.470" rotation="0 0 0"/>
        </itemPositions>
    </multipleItemPurchase>

    <multipleItemPurchaseAmountConfigurations>
        <multipleItemPurchaseAmountConfiguration name="1" price="0"/>
        <multipleItemPurchaseAmountConfiguration name="2" price="1200"/>
        <multipleItemPurchaseAmountConfiguration name="3" price="2400"/>
        <multipleItemPurchaseAmountConfiguration name="4" price="3600"/>
        <multipleItemPurchaseAmountConfiguration name="5" price="4800"/>
        <multipleItemPurchaseAmountConfiguration name="6" price="6000"/>
        <multipleItemPurchaseAmountConfiguration name="7" price="7200"/>
        <multipleItemPurchaseAmountConfiguration name="8" price="8400"/>
    </multipleItemPurchaseAmountConfigurations>

    <!-- label brand, handed on to every bought item -->
    <designConfigurations title="$l10n_fh_config_brand">
        <designConfiguration name="Opryskex" price="0"/>
        <designConfiguration name="MST" price="0"/>
    </designConfigurations>
</vehicle>
