    <storeData>
        <name>$l10n_fh_store_insecticideCanister20</name>
        <specs>
            <weight ignore="true"/>
        </specs>
        <functions>
            <function>$l10n_fh_function_insecticideCanister20</function>
        </functions>
        <image>pallets/canisters/store_insecticideCanister20.dds</image>
        <price>1200</price>
        <allowLeasing>false</allowLeasing>
        <canBeSold>false</canBeSold>
        <rotation>0</rotation>
        <shopHeight>0.55</shopHeight>
        <brand>OPRYSKEX</brand>
        <category>ibc palletFertilizerHerbicide</category>
        <financeCategory>PURCHASE_FERTILIZER</financeCategory>
        <vertexBufferMemoryUsage>512</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>256</indexBufferMemoryUsage>
