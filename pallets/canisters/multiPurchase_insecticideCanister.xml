<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="multipleItemPurchase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/vehicle.xsd">
    <!-- Buys 1 to 8 at once. Generated by source/tools/build_shop_items.py. -->
    <storeData>
        <name>$l10n_fh_store_insecticideCanister</name>
        <specs>
            <weight ignore="true"/>
        </specs>
        <functions>
            <function>$l10n_fh_function_insecticideCanister</function>
        </functions>
        <image>pallets/canisters/store_insecticideCanister.dds</image>
        <price>350</price>
        <allowLeasing>false</allowLeasing>
        <canBeSold>false</canBeSold>
        <rotation>0</rotation>
        <shopHeight>0.35</shopHeight>
        <brand>OPRYSKEX</brand>
        <category>ibc palletFertilizerHerbicide</category>
        <financeCategory>PURCHASE_FERTILIZER</financeCategory>
        <vertexBufferMemoryUsage>512</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>256</indexBufferMemoryUsage>
        <textureMemoryUsage>65536</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_pallet</typeDesc>
        <filename>$data/objects/multiPurchaseItem/multiPurchaseItem.i3d</filename>
        <size width="1.1" length="1.0" height="0.35"/>
        <input allowed="false"/>
        <canBeReset>false</canBeReset>
        <components>
            <component centerOfMass="0 0.1 0" solverIterationCount="10" mass="5.4" />
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false" />
    </base>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="INSECTICIDE" capacity="7250"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <multipleItemPurchase filename="pallets/canisters/insecticideCanister.xml" isVehicle="true">
        <itemPositions>
            <itemPosition position="0.000 0 0.000" rotation="0 0 0"/>
            <itemPosition position="-0.270 0 0.000" rotation="0 0 0"/>
            <itemPosition position="-0.540 0 0.000" rotation="0 0 0"/>
            <itemPosition position="-0.810 0 0.000" rotation="0 0 0"/>
            <itemPosition position="0.000 0 -0.300" rotation="0 0 0"/>
            <itemPosition position="-0.270 0 -0.300" rotation="0 0 0"/>
            <itemPosition position="-0.540 0 -0.300" rotation="0 0 0"/>
            <itemPosition position="-0.810 0 -0.300" rotation="0 0 0"/>
        </itemPositions>
    </multipleItemPurchase>

    <multipleItemPurchaseAmountConfigurations>
        <multipleItemPurchaseAmountConfiguration name="1" price="0"/>
        <multipleItemPurchaseAmountConfiguration name="2" price="350"/>
        <multipleItemPurchaseAmountConfiguration name="3" price="700"/>
        <multipleItemPurchaseAmountConfiguration name="4" price="1050"/>
        <multipleItemPurchaseAmountConfiguration name="5" price="1400"/>
        <multipleItemPurchaseAmountConfiguration name="6" price="1750"/>
        <multipleItemPurchaseAmountConfiguration name="7" price="2100"/>
        <multipleItemPurchaseAmountConfiguration name="8" price="2450"/>
    </multipleItemPurchaseAmountConfigurations>

    <!-- label brand, handed on to every bought item -->
    <designConfigurations title="$l10n_fh_config_brand">
        <designConfiguration name="Opryskex" price="0"/>
        <designConfiguration name="MST" price="0"/>
    </designConfigurations>
</vehicle>
