<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="pallet" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">
    <!-- Concentrate; the fill level is the spray mixture it makes. Generated by source/tools/build_shop_items.py. -->
    <storeData>
        <name>$l10n_fh_store_insecticideBottle</name>
        <functions>
            <function>$l10n_fh_function_insecticideBottle</function>
        </functions>
        <specs>
            <capacity>1450</capacity>
            <fillTypes>INSECTICIDE</fillTypes>
            <weight ignore="true"/>
        </specs>
        <image>pallets/bottles/store_insecticideBottle.dds</image>
        <price>80</price>
        <allowLeasing>false</allowLeasing>
        <canBeSold>false</canBeSold>
        <showInStore>false</showInStore>
        <rotation>0</rotation>
        <shopHeight>0.3</shopHeight>
        <brand>OPRYSKEX</brand>
        <category>ibc palletFertilizerHerbicide</category>
        <financeCategory>PURCHASE_FERTILIZER</financeCategory>
        <vertexBufferMemoryUsage>40768</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>6528</indexBufferMemoryUsage>
        <textureMemoryUsage>6291576</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_pallet</typeDesc>
        <filename>pallets/bottles/insecticideBottle.i3d</filename>
        <size width="0.1" length="0.1" height="0.26" />
        <input allowed="false"/>
        <canBeReset>false</canBeReset>
        <supportsPickUp>true</supportsPickUp>
        <components maxMass="5">
            <component centerOfMass="0 0.02 0" solverIterationCount="10" mass="3" />
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false" />
    </base>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits removeVehicleIfEmpty="true">
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="INSECTICIDE" capacity="1450" updateMass="false" startFillType="INSECTICIDE" startFillLevel="1450" ignoreFillLimit="true">
                        <fillRootNode node="0>" />
                    </fillUnit>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <!-- a sprayer standing next to it can be filled from it -->
    <fillTriggerVehicle triggerNode="fillTrigger" fillUnitIndex="1" litersPerSecond="200"/>

    <!-- label brand: the same container with the Opryskex or the MST label stickers -->
    <designConfigurations title="$l10n_fh_config_brand">
        <designConfiguration name="Opryskex" price="0">
            <objectChange node="bottle_label" visibilityActive="true" visibilityInactive="false"/>
        </designConfiguration>
        <designConfiguration name="MST" price="0">
            <objectChange node="bottle_label_mst" visibilityActive="true" visibilityInactive="false"/>
        </designConfiguration>
    </designConfigurations>

    <i3dMappings>
        <i3dMapping id="fillTrigger" node="0>0|0" />
        <i3dMapping id="bottle_vis" node="0>1|0" />
        <i3dMapping id="bottle_label" node="0>1|1" />
        <i3dMapping id="bottle_label_mst" node="0>1|2" />
    </i3dMappings>
</vehicle>
