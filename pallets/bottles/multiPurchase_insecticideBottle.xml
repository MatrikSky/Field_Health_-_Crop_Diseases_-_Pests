<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="multipleItemPurchase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/vehicle.xsd">
    <!-- Buys 1 to 12 at once. Generated by source/tools/build_shop_items.py. -->
    <storeData>
        <name>$l10n_fh_store_insecticideBottle</name>
        <specs>
            <weight ignore="true"/>
        </specs>
        <functions>
            <function>$l10n_fh_function_insecticideBottle</function>
        </functions>
        <image>pallets/bottles/store_insecticideBottle.dds</image>
        <price>80</price>
        <allowLeasing>false</allowLeasing>
        <canBeSold>false</canBeSold>
        <rotation>0</rotation>
        <shopHeight>0.3</shopHeight>
        <brand>OPRYSKEX</brand>
        <category>ibc palletFertilizerHerbicide</category>
        <financeCategory>PURCHASE_FERTILIZER</financeCategory>
        <vertexBufferMemoryUsage>512</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>256</indexBufferMemoryUsage>
        <textureMemoryUsage>65536</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_pallet</typeDesc>
        <filename>$data/objects/multiPurchaseItem/multiPurchaseItem.i3d</filename>
        <size width="0.6" length="0.5" height="0.3"/>
        <input allowed="false"/>
        <canBeReset>false</canBeReset>
        <components>
            <component centerOfMass="0 0.1 0" solverIterationCount="10" mass="1.1" />
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false" />
    </base>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="INSECTICIDE" capacity="1450"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <multipleItemPurchase filename="pallets/bottles/insecticideBottle.xml" isVehicle="true">
        <itemPositions>
            <itemPosition position="0.000 0 0.000" rotation="0 0 0"/>
            <itemPosition position="-0.150 0 0.000" rotation="0 0 0"/>
            <itemPosition position="-0.300 0 0.000" rotation="0 0 0"/>
            <itemPosition position="-0.450 0 0.000" rotation="0 0 0"/>
            <itemPosition position="0.000 0 -0.150" rotation="0 0 0"/>
            <itemPosition position="-0.150 0 -0.150" rotation="0 0 0"/>
            <itemPosition position="-0.300 0 -0.150" rotation="0 0 0"/>
            <itemPosition position="-0.450 0 -0.150" rotation="0 0 0"/>
            <itemPosition position="0.000 0 -0.300" rotation="0 0 0"/>
            <itemPosition position="-0.150 0 -0.300" rotation="0 0 0"/>
            <itemPosition position="-0.300 0 -0.300" rotation="0 0 0"/>
            <itemPosition position="-0.450 0 -0.300" rotation="0 0 0"/>
        </itemPositions>
    </multipleItemPurchase>

    <multipleItemPurchaseAmountConfigurations>
        <multipleItemPurchaseAmountConfiguration name="1" price="0"/>
        <multipleItemPurchaseAmountConfiguration name="2" price="80"/>
        <multipleItemPurchaseAmountConfiguration name="3" price="160"/>
        <multipleItemPurchaseAmountConfiguration name="4" price="240"/>
        <multipleItemPurchaseAmountConfiguration name="5" price="320"/>
        <multipleItemPurchaseAmountConfiguration name="6" price="400"/>
        <multipleItemPurchaseAmountConfiguration name="7" price="480"/>
        <multipleItemPurchaseAmountConfiguration name="8" price="560"/>
        <multipleItemPurchaseAmountConfiguration name="9" price="640"/>
        <multipleItemPurchaseAmountConfiguration name="10" price="720"/>
        <multipleItemPurchaseAmountConfiguration name="11" price="800"/>
        <multipleItemPurchaseAmountConfiguration name="12" price="880"/>
    </multipleItemPurchaseAmountConfigurations>

    <!-- label brand, handed on to every bought item -->
    <designConfigurations title="$l10n_fh_config_brand">
        <designConfiguration name="Opryskex" price="0"/>
        <designConfiguration name="MST" price="0"/>
    </designConfigurations>
</vehicle>
